# Invoice Ninja + OIDC via Laravel Socialite + Flutter shell patché (token-bridge)
# Stage 0 : build du bundle Flutter web depuis le fork PhilippeCaira/admin-portal
# Stage 1 : composer + patches PHP
# Stage 2 : image finale = upstream + patches PHP + bundle Flutter rebuilt
ARG INVOICENINJA_VERSION=5.13
ARG ADMIN_PORTAL_REF=oidc

# ─── Stage 0 : Flutter web build ──────────────────────────────────────────
FROM ghcr.io/cirruslabs/flutter:3.35.4 AS flutter-build
ARG ADMIN_PORTAL_REF=oidc
USER root
WORKDIR /src
RUN git clone --depth 1 --branch ${ADMIN_PORTAL_REF} \
        https://github.com/PhilippeCaira/admin-portal.git /src/admin-portal
WORKDIR /src/admin-portal
RUN git config --global --add safe.directory /src/admin-portal && \
    cp lib/.env.dart.example lib/.env.dart && \
    flutter config --enable-web --no-analytics && \
    flutter pub get && \
    flutter build web --release --no-tree-shake-icons --pwa-strategy=none

# ─── Stage 1 : composer install + patches PHP ─────────────────────────────
FROM invoiceninja/invoiceninja:${INVOICENINJA_VERSION} AS build
USER root
RUN apk add --no-cache git
COPY config/services.php /var/www/app/config/services.php
COPY app/Providers/EventServiceProvider.php /var/www/app/app/Providers/EventServiceProvider.php
COPY app/Libraries/OAuth/OAuth.php /var/www/app/app/Libraries/OAuth/OAuth.php
COPY app/Http/Controllers/Auth/LoginController.php /var/www/app/app/Http/Controllers/Auth/LoginController.php
COPY app/Http/Controllers/BaseController.php /var/www/app/app/Http/Controllers/BaseController.php
COPY app/Http/Controllers/TokenBridgeController.php /var/www/app/app/Http/Controllers/TokenBridgeController.php
COPY routes/web.php /var/www/app/routes/web.php
COPY resources/views/index/index.blade.php /var/www/app/resources/views/index/index.blade.php
COPY resources/views/react/index.blade.php /var/www/app/resources/views/react/index.blade.php
RUN cd /var/www/app && \
    # invoiceninja/admin-api a été supprimé de GitHub (404). On retire la
    # référence VCS morte du composer.json embarqué dans l'image 5.13 avant
    # toute résolution. Sans ça, "composer require -W" tente de cloner le
    # repo inaccessible et échoue.
    php -r '$c = json_decode(file_get_contents("composer.json"), true); $c["repositories"] = array_values(array_filter($c["repositories"] ?? [], fn($r) => !str_contains($r["url"] ?? "", "invoiceninja/admin-api"))); file_put_contents("composer.json", json_encode($c, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));' && \
    composer config --global use-github-api false && \
    composer config --global github-protocols https && \
    composer require kovah/laravel-socialite-oidc --no-interaction --no-scripts --prefer-dist -W

# ─── Stage 2 : image finale ───────────────────────────────────────────────
FROM invoiceninja/invoiceninja:${INVOICENINJA_VERSION} AS invoiceninja-oidc
COPY --from=build /var/www/app/config/services.php /var/www/app/config/services.php
COPY --from=build /var/www/app/app/Providers/EventServiceProvider.php /var/www/app/app/Providers/EventServiceProvider.php
COPY --from=build /var/www/app/app/Libraries/OAuth/OAuth.php /var/www/app/app/Libraries/OAuth/OAuth.php
COPY --from=build /var/www/app/app/Http/Controllers/Auth/LoginController.php /var/www/app/app/Http/Controllers/Auth/LoginController.php
COPY --from=build /var/www/app/app/Http/Controllers/BaseController.php /var/www/app/app/Http/Controllers/BaseController.php
COPY --from=build /var/www/app/app/Http/Controllers/TokenBridgeController.php /var/www/app/app/Http/Controllers/TokenBridgeController.php
COPY --from=build /var/www/app/routes/web.php /var/www/app/routes/web.php
COPY --from=build /var/www/app/resources/views/index/index.blade.php /var/www/app/resources/views/index/index.blade.php
COPY --from=build /var/www/app/resources/views/react/index.blade.php /var/www/app/resources/views/react/index.blade.php
COPY --from=build /var/www/app/vendor /var/www/app/vendor
COPY --from=build /var/www/app/composer.json /var/www/app/composer.json
COPY --from=build /var/www/app/composer.lock /var/www/app/composer.lock

# Bundle Flutter patché : remplace le main.foss.dart.js upstream
# Le patch admin-portal lit `localStorage['X-NINJA-TOKEN']` au boot et
# appelle /api/v1/refresh pour hydrater AppState — bypass du login form.
COPY --from=flutter-build /src/admin-portal/build/web/main.dart.js /var/www/app/public/main.foss.dart.js
COPY --from=flutter-build /src/admin-portal/build/web/main.dart.js /var/www/app/public/main.dart.js
COPY --from=flutter-build /src/admin-portal/build/web/flutter_service_worker.js /var/www/app/public/flutter_service_worker.js
COPY --from=flutter-build /src/admin-portal/build/web/assets /var/www/app/public/assets
COPY --from=flutter-build /src/admin-portal/build/web/canvaskit /var/www/app/public/canvaskit
