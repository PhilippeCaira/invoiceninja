# Invoice Ninja + OIDC via Laravel Socialite
# Stage 1 : installer le package OIDC (git nécessaire pour composer)
# Stage 2 : image finale propre sans outils de build
ARG INVOICENINJA_VERSION=5.13
FROM invoiceninja/invoiceninja:${INVOICENINJA_VERSION} AS build

USER root
RUN apk add --no-cache git
COPY config/services.php /var/www/app/config/services.php
COPY app/Providers/EventServiceProvider.php /var/www/app/app/Providers/EventServiceProvider.php
COPY app/Libraries/OAuth/OAuth.php /var/www/app/app/Libraries/OAuth/OAuth.php
COPY app/Http/Controllers/Auth/LoginController.php /var/www/app/app/Http/Controllers/Auth/LoginController.php
RUN cd /var/www/app && \
    composer config --global use-github-api false && \
    composer config --global github-protocols https && \
    composer require kovah/laravel-socialite-oidc --no-interaction --no-scripts --prefer-dist -W

FROM invoiceninja/invoiceninja:${INVOICENINJA_VERSION} AS invoiceninja-oidc
COPY --from=build /var/www/app/config/services.php /var/www/app/config/services.php
COPY --from=build /var/www/app/app/Providers/EventServiceProvider.php /var/www/app/app/Providers/EventServiceProvider.php
COPY --from=build /var/www/app/app/Libraries/OAuth/OAuth.php /var/www/app/app/Libraries/OAuth/OAuth.php
COPY --from=build /var/www/app/app/Http/Controllers/Auth/LoginController.php /var/www/app/app/Http/Controllers/Auth/LoginController.php
COPY --from=build /var/www/app/vendor /var/www/app/vendor
COPY --from=build /var/www/app/composer.json /var/www/app/composer.json
COPY --from=build /var/www/app/composer.lock /var/www/app/composer.lock
